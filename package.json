{
  "name": "draftwrite-electron",
  "version": "1.0.0",
  "description": "Desktop app for writers: organize stories and the articles based on them",
  "main": "./out/main/main.js",
  "desktopName": "draftwrite.desktop",
  "author": "Rene Garcia <rsamuelgarcia@gmail.com>",
  "homepage": "https://github.com/resagar/draftwrite",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 NODE_OPTIONS=--experimental-vm-modules electron node_modules/jest/bin/jest.js",
    "build": "npm run typecheck && electron-vite build && npm run copy:migrations",
    "copy:migrations": "node scripts/copy-migrations.cjs",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "6.4.0",
    "@uiw/react-codemirror": "^4.25.12",
    "better-sqlite3": "^13.0.3",
    "codemirror": "^6.0.2",
    "daisyui": "^5.7.50",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.59.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@jest/globals": "^30.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
